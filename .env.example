# Appwrite Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# Appwrite Endpoint (usually https://cloud.appwrite.io/v1)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite Project ID (get from Appwrite dashboard)
APPWRITE_PROJECT_ID=YOUR_PROJECT_ID

# Optional: Database ID (if using databases)
APPWRITE_DATABASE_ID=YOUR_DATABASE_ID

# Optional: Collection IDs (if using collections)
APPWRITE_USER_COLLECTION_ID=YOUR_USER_COLLECTION_ID
APPWRITE_TICKET_COLLECTION_ID=YOUR_TICKET_COLLECTION_ID

# Milwaukee Domes Management API Configuration
# Copy this file to .env and fill in your values

# App Settings
APP_NAME="Milwaukee Domes Management"
APP_VERSION="0.1.0"
DEBUG=false

# API Settings
API_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Appwrite Configuration
# Get these values from your Appwrite console: https://cloud.appwrite.io/console
APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="your-project-id-here"
APPWRITE_API_KEY="your-api-key-here"
APPWRITE_DATABASE_ID="milwaukee-domes"

# Appwrite Collection IDs (create these in your Appwrite database)
TOURS_COLLECTION_ID="tours"
SCAVENGER_HUNTS_COLLECTION_ID="scavenger-hunts"
CAFE_TOURS_COLLECTION_ID="cafe-tours"
PLANTS_COLLECTION_ID="plants"
PROGRESS_COLLECTION_ID="progress"
TICKETS_COLLECTION_ID="tickets"

# JWT Authentication
# Generate a secure secret key: openssl rand -hex 32
SECRET_KEY="your-secret-key-here-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin Credentials
# These are used for initial admin access
# In production, use a strong password and consider moving to Appwrite Users
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-secure-password"
